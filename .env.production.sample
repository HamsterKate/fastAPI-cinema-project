# Application
APP_NAME=Online Cinema API
APP_ENV=production
DEBUG=false

# Database
POSTGRES_DB=cinema
POSTGRES_USER=cinema
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SMTP (temporary server-side MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cinema.local

# MinIO / S3 storage
MINIO_ROOT_USER=cinema_minio
MINIO_ROOT_PASSWORD=replace_with_a_long_random_password
MINIO_BUCKET=cinema-avatars
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9000
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=900

# Stripe
STRIPE_SECRET_KEY=your_sk_test_key
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://YOUR_SERVER_IP:8000/docs?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://YOUR_SERVER_IP:8000/docs?payment=cancel

# Security and application URLs
JWT_SECRET_KEY=replace_with_a_secure_random_secret
ACTIVATION_URL=http://YOUR_SERVER_IP:8000/api/v2/accounts/activate
PASSWORD_RESET_URL=http://YOUR_FRONTEND_URL/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15